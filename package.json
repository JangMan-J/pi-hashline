{
  "name": "@jangmanj/pi-hashline",
  "version": "0.1.1",
  "type": "module",
  "description": "oh-my-pi hashline edit mode ported as a Pi coding-agent extension",
  "license": "MIT",
  "author": "JangMan-J",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "hashline",
    "anchored-edit"
  ],
  "files": [
    "index.ts",
    "config.ts",
    "picker.ts",
    "replay.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "init-package": "node scripts/init-package.mjs",
    "bootstrap:npm": "bash scripts/npm-bootstrap.sh"
  },
  "dependencies": {
    "@oh-my-pi/pi-natives": "18.20.0",
    "@oh-my-pi/pi-natives-linux-x64": "^18.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-hashline.git"
  },
  "homepage": "https://github.com/JangMan-J/pi-hashline#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-hashline/issues"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "~22.19.0",
    "jiti": "2.7.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.5.2",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
